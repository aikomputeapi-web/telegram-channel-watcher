[Unit] 
Description=Cred search Flask UI 
After=network-online.target 
Wants=network-online.target 
 
[Service] 
Type=simple 
WorkingDirectory=/opt/tg-watcher 
ExecStart=/opt/tg-watcher/.venv/bin/python /opt/tg-watcher/search_server.py 
Restart=always 
RestartSec=30 
 
[Install] 
WantedBy=multi-user.target
