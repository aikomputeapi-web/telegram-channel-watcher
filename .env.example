# from https://my.telegram.org -> API development tools
TG_API_ID=123456
TG_API_HASH=0123456789abcdef0123456789abcdef

# from `python make_session.py` (preferred) - or leave empty to use a local
# watcher-session file created on first interactive login
TG_SESSION_STRING=

# @channelname | https://t.me/channelname | https://t.me/c/1234567 | -1001234567890
CHANNEL=

DOWNLOAD_DIR=downloads
STATE_FILE=state.json
# one-time catch-up on the very first run (0 = disable)
BACKFILL_HOURS=24
# window re-checked on every start, catches posts missed while offline
SWEEP_HOURS=2
# optional: explicit path to 7z/7zz binary (auto-detected otherwise)
#SEVENZIP=C:\Program Files\7-Zip\7z.exe
