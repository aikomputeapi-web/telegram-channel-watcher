# from https://my.telegram.org -> API development tools
TG_API_ID=123456
TG_API_HASH=0123456789abcdef0123456789abcdef

# from `python make_session.py` (preferred) - or leave empty to use a local
# watcher-session file created on first interactive login
TG_SESSION_STRING=

# @channelname | https://t.me/channelname | https://t.me/c/1234567 | -1001234567890
CHANNEL=

DOWNLOAD_DIR=downloads
STATE_FILE=state.json
# one-time catch-up on the very first run (0 = disable)
BACKFILL_HOURS=24
# window re-checked on every start, catches posts missed while offline
SWEEP_HOURS=2
# comma-separated bot usernames whose t.me/<bot>?start=... buttons may be followed
DOWNLOAD_BOTS=boxedrobot
# seconds to wait for a download bot to return the document
BOT_RESPONSE_TIMEOUT=120
# optional: explicit path to 7z/7zz binary (auto-detected otherwise)
#SEVENZIP=C:\Program Files\7-Zip\7z.exe
# optional: run the stealer-log-parser over each extracted archive (1/0)
#PARSE_LOGS=1
# optional: redaction profile for parser output ('none' | 'partial' | 'full')
#PARSER_REDACTION=none
# optional: force a stealer family, or 'auto' to detect (see stealer-log-parser)
#PARSER_FAMILY=auto
# optional: skip parsing extractions larger than these (defaults: 6144 MB / 300000 files)
#PARSE_MAX_TOTAL_MB=6144
#PARSE_MAX_FILES=300000
# optional: parse large extractions in ~this many MB / files per batch
#PARSE_BATCH_MB=512
#PARSE_BATCH_FILES=4000
# optional: upload parsed outputs to your PC via a cloudflared tunnel (URL only)
#UPLOAD_URL=https://xxxx.trycloudflare.com
